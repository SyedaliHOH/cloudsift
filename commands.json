      ],
      "csv": "Name,Region",
      "pafa": "false = fail, true = pass"
    },
    {
      "title": "AWS Config Not Enabled",
      "severity": "medium",
      "commands": [
        "aws configservice describe-configuration-recorders --region <Region>",

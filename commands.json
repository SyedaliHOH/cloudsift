{
  "commands": [
    {
      "title": "CloudTrail Service Not Configured",
      "severity": "high",
      "commands": [
        "aws cloudtrail list-trails --region <Region> --query 'Trails[*].Name'",
        "aws cloudtrail describe-trails --region <Region> --trail-name-list <TrailName> --query 'trailList[*].IsMultiRegionTrail'"
      ],
      "csv": "ARN,Name,MultiRegion",
      "pafa": "[] or [true] = pass, false = fail"
    },
    {
      "title": "EBS Snapshot Not Encrypted",
      "severity": "high",
      "commands": [
        "aws ec2 describe-snapshots --region <Region> --snapshot-id <SnapshotId> --query 'Snapshots[*].Encrypted'"
      ],
      "csv": "ARN,Name,Encrypted",
      "pafa": "false = fail"
    },
    {
      "title": "EBS Volume Not Encrypted",
      "severity": "high",
      "commands": [
        "aws ec2 describe-volumes --region <Region> --volume-ids <VolumeId> --query 'Volumes[*].Encrypted'"
      ],
      "csv": "ARN,Name,Encrypted",
      "pafa": "false = fail"
    },
    {
      "title": "Drop Invalid Header Fields Disabled",
      "severity": "high",
      "commands": [
        "aws elbv2 describe-load-balancer-attributes --region <Region> --load-balancer-arn <LoadBalancerArn> --query 'Attributes[?(Key==`routing.http.drop_invalid_header_fields.enabled`)].Value'"
      ],
      "csv": "Name,ARN,DNS",
      "pafa": ""
    },
    {
      "title": "Load Balancer Allowing Clear Text (HTTP) Communication",
      "severity": "high",
      "commands": [
        "aws elbv2 describe-listeners --region <Region> --load-balancer-arn <LoadBalancerArn> --query 'Listeners[*].Protocol'"
      ],
      "csv": "Name,ARN,DNS",
      "pafa": "HTTP = fail, HTTPS = pass"
    },
    {
      "title": "Credentials Unused for 90 Days or Greater Are Not Disabled",
      "severity": "high",
      "commands": [
        "aws iam list-access-keys --user-name <UserName>",
        "aws iam get-access-key-last-used --access-key-id <AccessKeyId>"
      ],
      "csv": "Name,AccessKey1LastUsed,AccessKey2LastUsed,PasswordEnabled",
      "pafa": ""
    },
    {
      "title": "Cross-Account AssumeRole Policy Lacks External ID and MFA",
      "severity": "high",
      "commands": [
        "aws iam get-role --role-name <RoleName>"
      ],
      "csv": "Name,ARN",
      "pafa": "Check if policy contains sts:ExternalId or MFA"
    },
    {
      "title": "Lack of Key Rotation for 90 Days",
      "severity": "high",
      "commands": [
        "aws iam get-user --user-name <UserName>"
      ],
      "csv": "ARN,CreateDate",
      "pafa": ""
    },
    {
      "title": "Managed Policies Allow Overly Broad IAM Access",
      "severity": "high",
      "commands": [
        "aws iam get-policy-version --policy-arn <PolicyArn> --version-id v1 --query 'PolicyVersion.Document'"
      ],
      "csv": "PolicyName,RiskPattern,AffectedActions,AttachedRoles",
      "pafa": ""
    },
    {
      "title": "Managed Policy Allows All Actions",
      "severity": "high",
      "commands": [
        "aws iam get-policy --policy-arn <PolicyArn>"
      ],
      "csv": "ARN,Roles,Users",
      "pafa": ""
    },
    {
      "title": "Root Account without Hardware MFA",
      "severity": "high",
      "commands": [
        "aws iam generate-credential-report",
        "aws iam get-credential-report --query 'Content' --output text | base64 --decode > cred-report.csv",
        "cat cred-report.csv | head -n 2"
      ],
      "csv": "",
      "pafa": ""
    },
    {
      "title": "RDS Instance Publicly Accessible",
      "severity": "high",
      "commands": [
        "aws rds describe-db-instances --region <Region> --db-instance-identifier <DBInstanceIdentifier> --query 'DBInstances[*].PubliclyAccessible'"
      ],
      "csv": "Name,ARN,MultiAZ",
      "pafa": "true = fail, false = pass"
    },
    {
      "title": "Single AZ RDS Instance",
      "severity": "high",
      "commands": [
        "aws rds describe-db-instances --region <Region> --db-instance-identifier <DBInstanceIdentifier> --query 'DBInstances[*].MultiAZ'"
      ],
      "csv": "Name,ARN,MultiAZ",
      "pafa": "false = fail, true = pass"
    },
    {
      "title": "Get Actions Authorized to All Principals",
      "severity": "high",
      "commands": [
        "aws s3api get-bucket-policy --bucket <BucketName> --query Policy --output text"
      ],
      "csv": "Name,ARN",
      "pafa": ""
    },
    {
      "title": "ACM Certificate with Transparency Logging Set to Disabled",
      "severity": "medium",
      "commands": [
        "aws acm describe-certificate --certificate-arn <CertificateArn> --region <Region> --query 'Certificate.Options'"
      ],
      "csv": "ARN",
      "pafa": ""
    },
    {
